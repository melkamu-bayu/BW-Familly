             Notification.title == title,
             Notification.is_read.is_(False),
         )
-    ).scalar_one_or_none()
+    ).scalars().first()  # .first(): duplicates must never crash the whole run
     if existing is not None:
         return False
     db.add(Notification(user_id=user_id, type=notif_type, title=title, body=body))
+    # Session autoflush is off; flush so the next identical notification in this
+    # same run is found by the query above instead of being inserted again.
+    db.flush()
     return True
 
 
