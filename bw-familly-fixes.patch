diff --git a/assetflow-backend/tests/test_regressions.py b/assetflow-backend/tests/test_regressions.py
new file mode 100644
index 0000000..b86e1fc
--- /dev/null
+++ b/assetflow-backend/tests/test_regressions.py
@@ -0,0 +1,187 @@
+import uuid
+from datetime import date, timedelta
+
+from jose import jwt
+
+from app.core.config import settings
+from tests.conftest import revenue_payload
+
+API = "/api/v1"
+
+
+# ---------- auth ----------
+
+def test_login_email_is_case_insensitive(client):
+    r = client.post(f"{API}/auth/login", json={"email": "Admin@AssetFlow.app", "password": "ChangeMe123!"})
+    assert r.status_code == 200
+
+
+def test_token_with_malformed_subject_is_401_not_500(client):
+    bad = jwt.encode({"sub": "not-a-uuid", "type": "access"}, settings.JWT_SECRET_KEY, algorithm=settings.JWT_ALGORITHM)
+    r = client.get(f"{API}/auth/me", headers={"Authorization": f"Bearer {bad}"})
+    assert r.status_code == 401
+
+
+def test_refresh_token_missing_claims_is_401(client):
+    bad = jwt.encode({"type": "refresh"}, settings.JWT_SECRET_KEY, algorithm=settings.JWT_ALGORITHM)
+    r = client.post(f"{API}/auth/refresh", json={"refresh_token": bad})
+    assert r.status_code == 401
+
+
+# ---------- rate limiting ----------
+
+def test_rate_limit_buckets_differ_per_user():
+    from starlette.requests import Request
+    from app.core.rate_limit import client_identity
+
+    def req(token):
+        return Request({"type": "http", "headers": [(b"authorization", f"Bearer {token}".encode())],
+                        "client": ("1.2.3.4", 1)})
+
+    a = jwt.encode({"sub": str(uuid.uuid4()), "type": "access"}, settings.JWT_SECRET_KEY, algorithm="HS256")
+    b = jwt.encode({"sub": str(uuid.uuid4()), "type": "access"}, settings.JWT_SECRET_KEY, algorithm="HS256")
+    assert client_identity(req(a)) != client_identity(req(b))
+
+
+# ---------- transaction codes / validation ----------
+
+def test_transaction_code_survives_hard_deleted_rows(client, auth, db, vehicle_unit_id, cash_account_id):
+    from sqlalchemy import text
+    codes = []
+    for _ in range(2):
+        r = client.post(f"{API}/revenue", json=revenue_payload(vehicle_unit_id, cash_account_id), headers=auth)
+        assert r.status_code == 201, r.text
+        codes.append(r.json()["transaction_code"])
+    db.execute(text("DELETE FROM audit_logs WHERE entity_id IN (SELECT id FROM revenue_transactions WHERE transaction_code=:c)"), {"c": codes[0]})
+    db.execute(text("DELETE FROM revenue_transactions WHERE transaction_code=:c"), {"c": codes[0]})
+    db.commit()
+    r = client.post(f"{API}/revenue", json=revenue_payload(vehicle_unit_id, cash_account_id), headers=auth)
+    assert r.status_code == 201, r.text
+    assert r.json()["transaction_code"] not in codes
+
+
+def test_unknown_account_is_404_not_500(client, auth, vehicle_unit_id):
+    r = client.post(f"{API}/revenue", json=revenue_payload(vehicle_unit_id, str(uuid.uuid4())), headers=auth)
+    assert r.status_code == 404, r.text
+
+
+def test_unknown_business_unit_is_404_not_500(client, auth, cash_account_id):
+    r = client.post(f"{API}/expenses", json={**revenue_payload(str(uuid.uuid4()), cash_account_id)}, headers=auth)
+    assert r.status_code == 404, r.text
+
+
+# ---------- vehicles ----------
+
+def test_vehicle_update_with_dates_writes_audit_log(client, auth):
+    v = client.get(f"{API}/vehicles", headers=auth).json()[0]
+    r = client.patch(f"{API}/vehicles/{v['id']}", json={"insurance_expiry": "2030-01-31"}, headers=auth)
+    assert r.status_code == 200, r.text
+    assert r.json()["insurance_expiry"] == "2030-01-31"
+
+
+# ---------- shop ----------
+
+def _make_product(client, auth, qty_purchase, cash_account_id):
+    sku = f"T-{uuid.uuid4().hex[:8]}"
+    p = client.post(f"{API}/shop/products", headers=auth, json={
+        "name": sku, "sku": sku, "unit": "piece", "purchase_price": 60, "selling_price": 100}).json()
+    r = client.post(f"{API}/shop/purchases", headers=auth, json={
+        "invoice_number": f"PUR-{uuid.uuid4().hex}", "account_id": cash_account_id, "payment_status": "paid",
+        "purchase_date": date.today().isoformat(), "idempotency_key": str(uuid.uuid4()),
+        "items": [{"product_id": p["id"], "quantity": qty_purchase, "unit_price": 60}]})
+    assert r.status_code == 201, r.text
+    return p
+
+
+def _sale(client, auth, cash_account_id, items, discount=0):
+    return client.post(f"{API}/shop/sales", headers=auth, json={
+        "invoice_number": f"SALE-{uuid.uuid4().hex}", "account_id": cash_account_id, "payment_status": "paid",
+        "discount": discount, "sale_date": date.today().isoformat(),
+        "idempotency_key": str(uuid.uuid4()), "items": items})
+
+
+def test_shop_discount_is_only_subtracted_once(client, auth, cash_account_id):
+    before = client.get(f"{API}/shop/dashboard", headers=auth).json()
+    p = _make_product(client, auth, 10, cash_account_id)
+    r = _sale(client, auth, cash_account_id, [{"product_id": p["id"], "quantity": 2, "unit_price": 100}], discount=20)
+    assert r.status_code == 201, r.text
+    assert r.json()["total_amount"] == 180
+    after = client.get(f"{API}/shop/dashboard", headers=auth).json()
+    # sold 2 @100 with 20 discount = 180 revenue; COGS = 2 * 60 = 120; gross = 60
+    assert round(after["revenue"] - before["revenue"], 2) == 180
+    assert round(after["cost_of_goods_sold"] - before["cost_of_goods_sold"], 2) == 120
+    assert round(after["gross_profit"] - before["gross_profit"], 2) == 60
+
+
+def test_inventory_purchases_are_not_double_counted_as_opex(client, auth, cash_account_id):
+    before = client.get(f"{API}/shop/dashboard", headers=auth).json()
+    _make_product(client, auth, 10, cash_account_id)  # buys 600 of stock, paid
+    after = client.get(f"{API}/shop/dashboard", headers=auth).json()
+    # stock purchases are an asset (and hit COGS when sold), not operating expense
+    assert round(after["operating_expenses"] - before["operating_expenses"], 2) == 0
+
+
+def test_cannot_oversell_via_duplicate_lines(client, auth, cash_account_id):
+    p = _make_product(client, auth, 5, cash_account_id)
+    r = _sale(client, auth, cash_account_id, [
+        {"product_id": p["id"], "quantity": 4, "unit_price": 100},
+        {"product_id": p["id"], "quantity": 4, "unit_price": 100}])
+    assert r.status_code == 400, r.text
+
+
+def test_discount_cannot_exceed_subtotal(client, auth, cash_account_id):
+    p = _make_product(client, auth, 5, cash_account_id)
+    r = _sale(client, auth, cash_account_id, [{"product_id": p["id"], "quantity": 1, "unit_price": 100}], discount=500)
+    assert r.status_code in (400, 422), r.text
+
+
+# ---------- rent ----------
+
+def test_rent_retry_with_same_key_is_not_applied_twice(client, auth, cash_account_id):
+    prop = client.get(f"{API}/properties", headers=auth).json()[0]
+    # unique billing period per run, so reruns against the same DB don't accumulate
+    period = date(2100 + uuid.uuid4().int % 7000, 1 + uuid.uuid4().int % 12, 15).isoformat()
+    body = {"period_month": period, "amount_due": 1000, "amount_paid": 400,
+            "account_id": cash_account_id, "idempotency_key": str(uuid.uuid4())}
+    first = client.post(f"{API}/properties/{prop['id']}/rent", json=body, headers=auth)
+    second = client.post(f"{API}/properties/{prop['id']}/rent", json=body, headers=auth)
+    assert first.status_code == 201 and second.status_code == 201, second.text
+    assert second.json()["amount_paid"] == 400
+    assert second.json()["status"] == "partial"
+
+
+# ---------- dashboard ----------
+
+def test_business_performance_contribution_when_overall_profit_is_zero(client, auth):
+    rows = client.get(f"{API}/dashboard/business-performance", headers=auth).json()
+    overall = sum(r["profit"] for r in rows)
+    if abs(overall) < 0.005:
+        assert all(r["percentage_contribution"] == 0 for r in rows)
+    else:
+        assert abs(sum(r["percentage_contribution"] for r in rows) - 100) < 0.1 * len(rows)
+
+
+# ---------- notifications ----------
+
+def test_notification_generation_is_repeatable_with_duplicate_source_rows(client, auth, db):
+    from app.models.business import Vehicle
+    v = db.query(Vehicle).first()
+    due = date.today() + timedelta(days=2)
+    for _ in range(2):  # two records, same unit + due date -> identical notification title
+        client.post(f"{API}/vehicles/{v.id}/maintenance", headers=auth,
+                    json={"description": "oil", "cost": 10, "performed_at": date.today().isoformat(),
+                          "next_due": due.isoformat()})
+    for _ in range(2):
+        r = client.post(f"{API}/notifications/generate", headers=auth)
+        assert r.status_code == 200, r.text
+
+
+# ---------- exports ----------
+
+def test_csv_export_neutralises_formula_cells():
+    from app.services.export_service import to_csv_bytes
+    out = to_csv_bytes(["Description"], [['=HYPERLINK("http://evil","x")'], ["@SUM(1)"], ["normal"]]).decode()
+    lines = out.splitlines()
+    assert lines[1].startswith("'") or lines[1].startswith('"\'')
+    assert "'@SUM(1)" in lines[2]
+    assert lines[3] == "normal"
