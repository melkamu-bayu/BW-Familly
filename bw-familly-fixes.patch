+"""
+Integration tests run against a real PostgreSQL database (the models use
+Postgres-only types: UUID, JSONB). Point TEST_DATABASE_URL at a throwaway DB:
+
+    export DATABASE_URL=postgresql+psycopg2://assetflow:assetflow@localhost:5432/assetflow_test
+    alembic upgrade head && python -m app.seed && pytest
+"""
+import uuid
+from datetime import date
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app.main import app
+from app.core.database import SessionLocal
+from app.models.business import BusinessUnit
+from app.models.financial import Account
+
+
+@pytest.fixture(scope="session")
+def client():
+    with TestClient(app) as c:
+        yield c
+
+
+@pytest.fixture(scope="session")
+def auth(client):
+    r = client.post("/api/v1/auth/login", json={"email": "admin@assetflow.app", "password": "ChangeMe123!"})
+    assert r.status_code == 200, r.text
+    return {"Authorization": f"Bearer {r.json()['access_token']}"}
+
+
+@pytest.fixture()
+def db():
+    with SessionLocal() as session:
+        yield session
+
+
+@pytest.fixture()
+def cash_account_id(db):
+    return str(db.query(Account).filter(Account.name == "Main Cash").one().id)
+
+
+@pytest.fixture()
+def vehicle_unit_id(db):
+    return str(db.query(BusinessUnit).filter(BusinessUnit.unit_type == "vehicle").first().id)
+
+
+@pytest.fixture()
+def shop_unit_id(db):
+    return str(db.query(BusinessUnit).filter(BusinessUnit.unit_type == "shop").one().id)
+
+
+def revenue_payload(unit_id, account_id, amount=100, **kw):
+    return {
+        "business_unit_id": unit_id, "account_id": account_id, "category": "test",
+        "amount": amount, "txn_date": date.today().isoformat(),
+        "idempotency_key": str(uuid.uuid4()), **kw,
+    }
