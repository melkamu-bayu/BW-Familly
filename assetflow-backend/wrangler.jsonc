{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assetflow-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "ASSETFLOW_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c3454de575ab4fadb132f7e9d76fcded"
    }
  ]
}
